# Local-only development values. Replace in deployment secret storage.

NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/luma_take_home
BETTER_AUTH_SECRET=dev-only-replace-with-random-secret
BETTER_AUTH_URL=http://localhost:3000
LOCAL_OBJECT_STORE_ROOT=./.local/object-store
WORKER_ID=worker-local
LOG_LEVEL=info

# Seeded evaluator accounts. These are fake defaults for local development only.
DEMO_WORKSPACE_NAME=Maya Home Goods
DEMO_MAYA_EMAIL=maya@example.test
DEMO_MAYA_PASSWORD=local-maya-password
DEMO_ELLIE_EMAIL=ellie@example.test
DEMO_ELLIE_PASSWORD=local-ellie-password

# Name only for later controlled integration. Do not place a real value in source control.
LUMA_API_KEY=
DEMO_GENERATION_BUDGET_CENTS=2500
